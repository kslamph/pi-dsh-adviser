{
	"name": "pi-dsh-adviser",
	"version": "0.1.0",
	"description": "Pi extension that turns a DeepSeek Harness runtime into an external adviser: its own context, its own model, per-project adviser sessions",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"adviser",
		"advisor",
		"second-opinion",
		"peer-review",
		"subagent",
		"multi-agent",
		"llm",
		"ai",
		"coding-agent"
	],
	"license": "MIT",
	"type": "module",
	"main": "index.ts",
	"engines": {
		"node": ">=22.19"
	},
	"files": [
		"index.ts",
		"advise.ts",
		"config.ts",
		"dshRoutes.ts",
		"handlers.ts",
		"prune.ts",
		"resolve.ts",
		"runner.ts",
		"sessions.ts",
		"config.example.json",
		"README.md",
		"LLMS.txt",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kslamph/pi-dsh-adviser.git"
	},
	"bugs": {
		"url": "https://github.com/kslamph/pi-dsh-adviser/issues"
	},
	"homepage": "https://github.com/kslamph/pi-dsh-adviser#readme",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"typescript": "^5.7.0"
	},
	"scripts": {
		"test": "node --test tests/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}